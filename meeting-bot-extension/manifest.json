{
  "manifest_version": 3,
  "name": "Markee Meeting Host Bot",
  "version": "1.0.0",
  "description": "Auto-joins Google Meet as host, admits waiting-room guests, for one PM-new operational mailbox.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Markee Meeting Host Bot"
  }
}
