# Dev/local use Supabase Cloud so developers do not need VPN or WARP. Prefer the
# transaction pooler (port 6543) for this persistent FastAPI service. URL-encode the
# password and require TLS. Production overrides this with its self-hosted URL.
DATABASE_URL=postgresql://postgres.asvtfrbkvgllqsksuyxp:Poptech%40123@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Supabase session-mode pooler (port 5432) caps the project at 20 connections.
# Keep workers x (pool_size + max_overflow) + background engine well below that
# limit, otherwise DB requests intermittently 500 with EMAXCONNSESSION.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
RUN_DB_STARTUP_ON_IMPORT=false

# Supabase HTTP API values are only needed by features that call Supabase
# directly. The current FastAPI backend uses DATABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Safe for both WARP and the company VPN. Override only if the local network team
# provides a different tested MTU.
DOCKER_NETWORK_MTU=1420

# Authentication. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
INTERNAL_SYNC_TOKEN=your-random-shared-secret-token

# kpi-dev already has users, so keep the password blank. Only set it once when
# intentionally provisioning a brand-new empty database.
DEFAULT_ADMIN_EMAIL=admin@company.com
DEFAULT_ADMIN_PASSWORD=
GOOGLE_LOGIN_ENABLED=true
PASSWORD_LOGIN_ENABLED=false
AUTH_SUPERADMIN_EMAILS=admin@example.com

# Microsoft (Outlook) login — additive to Google Login. OUTLOOK_TENANT_ID=common
# accepts both Microsoft personal accounts and Entra (work/school) accounts.
OUTLOOK_LOGIN_ENABLED=false
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=common

# Local frontend
PORTAL_BRAND=markee
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api
FRONTEND_URL=http://localhost:3000

# Google integrations (optional)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/meetings/google/callback

# AI integration (optional, OpenAI-compatible API)
AI_BASE_URL=https://api.shopaikey.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
CHECK_INTERVAL_SECONDS=3600

# Zoom integration (optional)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Transcription integration (optional)
ASSEMBLYAI_API_KEY=
