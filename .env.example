# Database config (Used by Docker Compose bridge network)
DATABASE_URL=postgresql://task_user:MyPass2026@postgres:5432/task_portal
REDIS_URL=redis://:MyPassRedis2026@redis:6379/0

# For local development outside Docker, uncomment these and comment the ones above:
# DATABASE_URL=postgresql://task_user:MyPass2026@127.0.0.1:5432/task_portal
# REDIS_URL=redis://:MyPassRedis2026@127.0.0.1:6379/0

# JWT Auth Secret Key
SECRET_KEY=8b7e289c09fe542f8c5b5257ef671d49e108cf1c944733e8a4d46c82302f23b2

# Google Service Account Credentials path inside backend container
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json

# AI Configuration (OpenAI compatible endpoint)
AI_BASE_URL=https://api.shopaikey.com/v1
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60

# Background Worker Settings
CHECK_INTERVAL_SECONDS=3600
