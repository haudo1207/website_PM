# Shared self-hosted Supabase development database (project: kpi-dev).
# DATABASE_URL is for running Python directly while the db_tunnel Compose service
# is active. Docker Compose overrides it with DATABASE_URL_DOCKER.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@127.0.0.1:15432/postgres
DATABASE_URL_DOCKER=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@db_tunnel:15432/postgres

# Authenticated PostgreSQL-over-WSS tunnel. Obtain DB_TUNNEL_PATH with the
# development .env through the secure team channel; never commit its real value.
DB_TUNNEL_HOST=dev.kpi.markeeai.com
DB_TUNNEL_PATH=db-tunnel-replace-with-the-private-tunnel-path
DB_TUNNEL_LOCAL_PORT=15432

# Authentication. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# kpi-dev already has users, so keep the password blank. Only set it once when
# intentionally provisioning a brand-new empty database.
DEFAULT_ADMIN_EMAIL=admin@company.com
DEFAULT_ADMIN_PASSWORD=

# Local frontend
PORTAL_BRAND=markee
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api
FRONTEND_URL=http://localhost:3000

# Google integrations (optional)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/meetings/google/callback

# AI integration (optional, OpenAI-compatible API)
AI_BASE_URL=https://api.shopaikey.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
CHECK_INTERVAL_SECONDS=3600

# Zoom integration (optional)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Transcription integration (optional)
ASSEMBLYAI_API_KEY=
